DEBUG=true
DISABLE_SECURITY=false
DEV_ADMIN_USER_ID=1
DEV_USER_ID=2
BASE_URL=http://localhost:3000
JWT_SECRET_KEY=YOUR-JWT-SECRET-KEY-HERE-MUST-BE-32-CHARS-MIN
JWT_ALGORITHM=HS256
OSU_CLIENT_ID=your-osu-client-id
OSU_CLIENT_SECRET=your-osu-client-secret
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_USERNAME=postgres
POSTGRESQL_PASSWORD=YOUR-POSTGRESQL-PASSWORD-HERE
POSTGRESQL_DATABASE=graveboards_dev
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# Daemon services
# Disable a service by setting its *_ENABLED to false; tune fetcher intervals in hours.
SERVICES_PROFILE_FETCHER_ENABLED=true
SERVICES_PROFILE_FETCHER_INTERVAL_HOURS=168.0
SERVICES_SCORE_FETCHER_ENABLED=true
SERVICES_SCORE_FETCHER_INTERVAL_HOURS=24.0
SERVICES_QUEUE_REQUEST_HANDLER_ENABLED=true
SERVICES_RULE_VALIDATION_ENABLED=true
